# MediLink Enterprise — Environment Configuration Example
# Copy this file to .env to configure MySQL credentials or custom settings.

# Database Engine: 'sqlite' (default for local zero-config testing) or 'mysql'
DB_ENGINE=sqlite

# MySQL Configuration (Active when DB_ENGINE=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=medilink_db

# Security & Authentication
SECRET_KEY=medilink-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Settings
PORT=8000
